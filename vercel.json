{
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron-refresh",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/img/psn/:path*",
      "destination": "https://image.api.playstation.com/:path*"
    },
    {
      "source": "/img/sgdb/:path*",
      "destination": "https://cdn2.steamgriddb.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
